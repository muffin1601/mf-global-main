# Public application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Pooled Supabase Postgres URL for the serverless application runtime.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Direct/session URL used only by Prisma Migrate and administrative scripts.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres

# Server-only Supabase secret key. Required for administrator user provisioning.
# Never prefix with NEXT_PUBLIC_. Prefer a scoped sb_secret_ key over legacy service_role.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Read-only legacy MongoDB source. Required only for the migration utility.
LEGACY_MONGODB_URI=mongodb://127.0.0.1:27017/crm
LEGACY_MONGODB_DATABASE=crm
MIGRATION_BATCH_SIZE=250
MIGRATION_REPORT_DIR=./migration-reports

# Contact/careers email integration.
RESEND_API_KEY=REPLACE_ME
CONTACT_EMAIL_FROM=Website <website@your-verified-domain.example>
CONTACT_EMAIL_TO=info@your-domain.example
IP_HASH_SALT=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

# External lead ingestion. Keep disabled until staging verification and cutover.
INTEGRATIONS_ENABLED=false
CRON_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
ENABLE_INDIAMART_SYNC=false
INDIAMART_API_KEY=REPLACE_ME
TRADEINDIA_USERID=REPLACE_ME
TRADEINDIA_PROFILE_ID=REPLACE_ME
TRADEINDIA_KEY=REPLACE_ME
# Shared by the Coachingpromo and Printkee webhook routes for MERN compatibility.
COACHINGPROMO_API_KEY=REPLACE_ME
# Marketing contact form (/api/send-email). Defaults match the original backend:
# from no-reply@mfglobalservices.com to sales@mfglobalservices.com.
# Careers application notifications (defaults match the original backend).
CAREERS_NOTIFICATION_EMAILS=sales@mfglobalservices.com,faruk@mfglobalservices.com
CAREERS_NOTIFICATION_FROM=no-reply@mfglobalservices.com
# Careers admin PIN fallback (bcrypt hash of a 6-digit PIN), used only until a PIN
# is stored in career_admin_settings (copied by migrate:mongo:marketing-files).
CAREERS_ADMIN_PIN_HASH=
