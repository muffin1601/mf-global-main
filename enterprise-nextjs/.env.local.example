# Copy this file to .env.local. Never commit .env.local or paste its secrets into chat.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:URL_ENCODED_PASSWORD@COPY_TRANSACTION_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
LEGACY_MONGODB_URI=mongodb://READ_ONLY_USER:URL_ENCODED_PASSWORD@HOST:27017/crm?authSource=admin
LEGACY_MONGODB_DATABASE=crm
MIGRATION_BATCH_SIZE=250
MIGRATION_REPORT_DIR=./migration-reports
RESEND_API_KEY=re_REPLACE_ME
CONTACT_EMAIL_FROM=Website <website@your-verified-domain.example>
CONTACT_EMAIL_TO=info@your-domain.example
IP_HASH_SALT=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
