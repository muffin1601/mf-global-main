{
  "name": "mf-global-enterprise-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "migrate:mongo:dry-run": "tsx scripts/migrate-mongodb/index.ts",
    "migrate:mongo:inventory": "tsx scripts/migrate-mongodb/inventory.ts",
    "migrate:mongo:audit-relations": "tsx scripts/migrate-mongodb/relationships.ts",
    "migrate:mongo:docs": "tsx scripts/migrate-mongodb/report-docs.ts",
    "migrate:mongo:apply": "tsx scripts/migrate-mongodb/index.ts --apply",
    "migrate:mongo:marketing-files": "tsx scripts/migrate-mongodb/marketing-files.ts",
    "sync:legacy-marketing": "node scripts/sync-legacy-marketing.mjs",
    "test": "vitest run",
    "test:db": "node scripts/test-db.mjs up",
    "verify:schema": "node scripts/verify-schema.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-table": "9.3.1",
    "axios": "^1.21.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "lucide-react": "1.74.0",
    "lucide-react-legacy": "npm:lucide-react@0.525.0",
    "next": "16.4.6",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.66.1",
    "react-icons": "^5.5.0",
    "recharts": "3.10.1",
    "resend": "6.38.1",
    "sonner": "^2.0.7",
    "swiper": "^14.4.0",
    "tailwind-merge": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.10.1",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "embedded-postgres": "^17.11.0-beta.19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.4.6",
    "mongodb": "^7.0.0",
    "playwright-core": "^1.62.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "effect": "3.22.1"
  }
}
