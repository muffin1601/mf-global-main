model LegacyOrphanRecord {
  id         String   @id @default(uuid()) @db.Uuid
  collection String
  legacyId   String   @map("legacy_id")
  reason     String
  sourceData Json     @map("source_data")
  sourceHash String   @map("source_hash")
  migratedAt DateTime @default(now()) @map("migrated_at")

  @@unique([collection, legacyId])
  @@index([collection, reason])
  @@map("legacy_orphan_records")
}

model LeadStatusHistory {
  id             String   @id @default(uuid()) @db.Uuid
  leadId         String   @map("lead_id") @db.Uuid
  fromStatus     String?  @map("from_status")
  toStatus       String   @map("to_status")
  fromCallStatus String?  @map("from_call_status")
  toCallStatus   String?  @map("to_call_status")
  changedById    String?  @map("changed_by_id") @db.Uuid
  changedAt      DateTime @default(now()) @map("changed_at")
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, changedAt(sort: Desc)])
  @@map("lead_status_history")
}

model IntegrationRun {
  id           String    @id @default(uuid()) @db.Uuid
  provider     String
  trigger      String    @default("cron")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String    @default("RUNNING")
  fetched      Int       @default(0)
  created      Int       @default(0)
  duplicates   Int       @default(0)
  failed       Int       @default(0)
  errorMessage String?   @map("error_message")
  meta         Json?

  @@index([provider, startedAt(sort: Desc)])
