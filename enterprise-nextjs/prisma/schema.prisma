model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start")

  @@index([windowStart])
  @@map("rate_limit_buckets")
}

model InvoiceCounter {
  prefix    String   @id
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("invoice_counters")
}

/// Append-only ownership history: one row per assignee added, removed or changed on a lead.
model LeadAssignmentEvent {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  /// ASSIGNED | UNASSIGNED | ACCESS_CHANGED
  action    String
  canUpdate Boolean? @map("can_update")
  /// create | import | assign | transfer | unassign | edit
  reason    String
  actorId   String?  @map("actor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user      User?    @relation("AssignmentEventUser", fields: [userId], references: [id], onDelete: SetNull)
  actor     User?    @relation("AssignmentEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("lead_assignment_events")
}

/// Unified sales activity: calls, emails, meetings, follow-ups, tasks and notes. Records are entered
/// by people. Nothing here means the system placed a call or sent an email.
model Activity {
  id            String            @id @default(uuid()) @db.Uuid
  type          ActivityType
  subject       String
  body          String            @default("")
  status        ActivityStatus    @default(OPEN)
  priority      ActivityPriority  @default(MEDIUM)
  dueAt         DateTime?         @map("due_at")
  completedAt   DateTime?         @map("completed_at")
  completedById String?           @map("completed_by_id") @db.Uuid
  outcome       String?
  leadId        String?           @map("lead_id") @db.Uuid
  createdById   String?           @map("created_by_id") @db.Uuid
  assigneeId    String?           @map("assignee_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  lead          Lead?             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  assignee      User?             @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy   User?             @relation("ActivityCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  comments      ActivityComment[]

  @@index([assigneeId, status, dueAt])
  @@index([status, dueAt])
  @@index([leadId, createdAt(sort: Desc)])
  @@index([createdById, createdAt(sort: Desc)])
  @@map("activities")
}

model ActivityComment {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @map("activity_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  author     User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([activityId, createdAt])
  @@map("activity_comments")
}

/// A named list configuration (filters, sort, columns) for a list page. Shared views are visible to
/// every user who can open that page. They never widen record access.
model SavedView {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  entity    String
  name      String
  params    Json
  shared    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entity, name])
  @@index([entity, shared])
  @@map("saved_views")
}
